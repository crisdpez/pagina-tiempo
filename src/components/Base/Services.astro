<style>
  .title-service {
    font-family:"Bricolage Grotesque", sans-serif;
    font-size: 30px;
    color:#2128bd;
    align-items: center;
    text-align: center;
   
  }
  .services-container {
    height: 1400px;
    margin: 0 auto;
    padding: 0px 20px;
   
    display: flex;
    transition: transform 0.3s ease;

    & :hover{
        transform: scale(1.05);
    }
  }

  .service {
    height: 450px;
    width: 250px;
    background: #fff;
    backdrop-filter: blur(30px);
    border-radius: 25px;
    color: #2c2c2c;
    border: solid 2px #2c2c2c;
    margin: auto;
    padding: 30px;
    justify-content: space-between;
    align-items: center;
    display: flex;
    justify-content: space-around;
    

    & h2{
        text-align: center;
        font-family: Roboto, sans-serif;
        font-size: 25px;
    }

    & p{
        text-align: justify;
        font-family: Roboto, sans-serif;
        font-size: 18px;
          line-height: 1.3;
    }
  }


  .service-icon{
    display:flex;
    justify-content: center;
  }
</style>
