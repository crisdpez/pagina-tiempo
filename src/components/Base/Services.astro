<style>
   <link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">

   .service-info{
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
   }

   .img-service img{
    height: 400px;
    width: auto;
    margin-left: 5px;
    object-fit: cover;
    display: flex;
    justify-content: center;

    & img{
      width: 70%;
      height: auto;
      object-fit: cover;
      border-radius: 15%;

    }
    
   }
  .title-service {
    font-family:"Bricolage Grotesque", sans-serif;
    font-size: 30px;
    color:#2128bd;
    align-items: center;
    text-align: start;
    padding-top: 180px;
    margin-left: 150px;
   
  }
  .services-container {
    height: 2000px;
    margin: 0 auto;
    padding: 0px 20px;
   
    display: flex;
    transition: transform 0.3s ease;

    & :hover{
        transform: scale(1.05);
    }
  }

  .service {
    height: auto;
    width: 300px;
    background: #fff;
    backdrop-filter: blur(30px);
    border-radius: 25px;
    color: #2c2c2c;
    border: solid 2px #2c2c2c;
    margin: 20px;
    padding: 30px;
    
    align-items: center;
    display: flex;
    justify-content: space-around;
    

    & h2{
        text-align: center;
        font-family: Roboto, sans-serif;
        font-size: 25px;
    }

    & p{
        text-align: justify;
        font-family: Roboto, sans-serif;
        font-size: 18px;
          line-height: 1.3;
    }
  }


  .service-icon{
    display:flex;
    justify-content: center;
  }

  .bloque1, .bloque2, .bloque3, .bloque4 {
    display: flex;
    flex-direction: row;
    justify-content: center;
    
  }
</style>

