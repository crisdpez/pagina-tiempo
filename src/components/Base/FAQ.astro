<style>

  .faq-container {
    height: 950px;
    display: flex;
    justify-content: center;
  }

  .faq-margin {
    margin: 0px 20px 0px 20px;
  }

  .faq-title {
    text-align: center;
    margin: 2rem 0;
    padding-top: 60px;
    color: #2128bd;
    font-size: 30px;
    font-weight: 500;
    font-family: "Bricolage Grotesque", sans-serif;
  }

  .questions-container {
    max-width: 800px;
    margin: auto;
  }

.angle-arrow {
   color: #fff;
    width: 20px;
  }

  .question button {
    width: 100%;
    background-color: #2128bd;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 20px 15px;
    border-radius: 15px;
    font-size: 22px;
    font-family: Roboto, sans-serif;
    font-weight: 600;
    font-weight: 700;
    color: #fff;
    cursor: pointer;
     outline: none;
    
  }
  .question p {
    font-size: 22px;
    font-family: Roboto, sans-serif;
    font-weight: 600;
    opacity: 0;
    line-height: 1.5;
    overflow: hidden;
    transition: all 0.6s ease;
  }
  .angle-arrow {
    transition: transform 0.5s ease-in;
    color: #fff;
  }

  .question p.show{
    max-height: 200px; 
    opacity: 1;
    padding:0px 15px 30px 15px;
}
.question button .d-arrow.rotate{
    transform: rotate(180deg);
}
</style>

<script>
    const buttons = document.querySelectorAll('button');

buttons.forEach( button =>{
    button.addEventListener('click',()=>{
        const faq = button.nextElementSibling;
        const icon = button.children[1];

        faq.classList.toggle('show');
        icon.classList.toggle('rotate');
    })
} )
</script>