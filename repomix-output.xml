  .alert-content {
    width: 40%;
    height: 700px;
    overflow: hidden;
    display: flex;
    justify-content: center;
    padding: 0px 30px 20px 30px;
  }

  .alert-title {
    width: 60%;
    max-height: 700px;
    padding-top: 90px;
    padding-bottom: 3px;
    font-family: "Bricolage Grotesque", sans-serif;
    font-weight: 500;
    font-size: 80px;
    display: flex;
    justify-content: center;
    flex-direction: column;
    text-align: left;
  }

  .alert-info {
    height: 90px;
    width: 480px;
    padding: 50px 30px;
    color: #2b2b2b;
    font-size: 30px;
    font-family: Roboto, sans-serif;
    font-weight: 400;
    padding-top: 40px;
    display: flex;
    justify-content: center;
    align-items: center;
    background: #ffffffb0;
    border-radius: 20px;
    text-align: justify;

    &:hover{
      background: #ffffff;
      box-shadow: 0px 0px 20px 0px #2128bd;
      transition: all 0.5s ease-in-out;
    }

  }

  .stroke {
    -webkit-text-stroke: 1px #2128bd;
    color: transparent;
    margin: 10px 0;
    transition: color 1.5s ease;
  }

  .stroke.relleno {
    color: #2128bd;
  }
</style>

<script>
  import Swal from 'sweetalert2';
  console.log("SweetAlert2 loaded:", Swal);
  //  Animación de stroke
  const stroke = document.querySelectorAll(".stroke");

  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add("relleno");
        }
      });
    },
    { threshold: 0.85 }
  ); // Cuando el 50% de la línea aparece

  stroke.forEach((stroke) => {
    observer.observe(stroke);
  });

//Alerta al hacer click

  document.addEventListener("DOMContentLoaded", () => {
    const el = document.getElementById("alert-info");
    if (el) {
      el.style.cursor = 'pointer'; 
      el.addEventListener("click", () => {
        Swal.fire({
        title: "Alerta",
        text: "¡Alertas tan chulas como esta!",
        icon: "success"
}
);
      });
    }
  });

</script>
